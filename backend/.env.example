PORT=4000
# Origin фронтенда: он же единственный разрешённый CORS-origin и база
# для ссылок в письмах.
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Строка подключения к Postgres (Railway → Postgres → Connect).
# Локально можно пробросить туннелем:
#   railway connect Postgres --tunnel-only --port 15432
DATABASE_URL=

# Подписывает сессионные токены. Сгенерировать:
#   openssl rand -hex 32
# Смена значения разлогинивает всех.
JWT_SECRET=

# Имя куки с сессией. Разные значения для прода и локальной разработки
# избавляют от перетирания сессий в одном браузере.
SESSION_COOKIE_NAME=planly_session

# Домен куки. Пусто = хост backend'а. Задавать только если фронт и бэк
# на поддоменах одного домена: .planly.app
SESSION_COOKIE_DOMAIN=

# Запрещать вход до подтверждения почты. Включать только после того, как
# заработает отправка писем (RESEND_API_KEY), иначе запрёт всех снаружи.
REQUIRE_EMAIL_VERIFICATION=false

# Отправка писем через Resend (https://resend.com → API Keys). Пусто —
# письма не отправляются, а ссылка пишется в лог: этого достаточно для
# локальной разработки.
RESEND_API_KEY=
MAIL_FROM=Planly <onboarding@resend.dev>
