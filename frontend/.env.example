# Origin бэкенда. Локально это backend из этого же репозитория,
# на Railway — публичный домен сервиса backend.
# Переменная попадает в клиентский бандл (префикс NEXT_PUBLIC_), поэтому
# здесь не должно быть ничего секретного — origin API таковым не является.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Имя куки с сессией. Должно совпадать с SESSION_COOKIE_NAME бэкенда —
# proxy.ts читает эту куку, чтобы решить, пускать ли на приватные
# страницы.
NEXT_PUBLIC_SESSION_COOKIE_NAME=planly_session
